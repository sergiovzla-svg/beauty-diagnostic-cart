.env
.env.*
!.env.example

# 3. DATOS DE CLIENTES
clientes/

# 4. FOTOS EN BRUTO DE CÁMARA (ARCHIVOS PESADOS DE +200 MB)
input_images/

# 5. CARPETAS TEMPORALES Y CACHÉ
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.tmp*
*.tmp
scratch/

# 6. SISTEMAS OPERATIVOS Y EDITORES
